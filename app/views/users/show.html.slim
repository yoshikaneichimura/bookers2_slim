div.container.mt-3
  div.row
    div.col-md-3

      = render 'books/user_info', book_new: @book_new, user: @user

    div.col-md-8.offset-md-1
      h2 Books
      table.table.table-hover.table-inverse
        thead
          tr
            th
            th Title
            th Opinion
            th
          - @books.each do |book|
            tbody
              tr
                td  = link_to user_path(book.user.id) do
                      = image_tag book.user.get_profile_image(100,100)
                td = link_to book.title, book_path(book.id)
                td = book.body
                td